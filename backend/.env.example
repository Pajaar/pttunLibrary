# Port the Express server listens on. Optional, defaults to 5000.
PORT=5000

# --- Database connection ---
# Either set DATABASE_URL (or MYSQL_URL / MYSQL_PUBLIC_URL) to a single
# connection string, OR set the individual DB_* vars below. If a URL var is
# set, it takes priority over the individual vars.
# DATABASE_URL=mysql://user:password@host:port/database_name

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=db_perpustakaan_pttun

# --- Auth ---
# Required — the server refuses to start without this. Generate a random
# value with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Origin allowed to send credentialed (cookie-carrying) requests to this API.
# Optional, defaults to http://localhost:5173 (the local Vite dev server).
FRONTEND_URL=http://localhost:5173

# --- Cloudinary ---
# Required for uploading images to Cloudinary. Create a free account at
# https://cloudinary.com/ and get your cloud name, API key, and API secret
CLOUDINARY_CLOUD_NAME= yourcloudname
CLOUDINARY_API_KEY= yourapikey
CLOUDINARY_API_SECRET= yourapisecret